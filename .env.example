# Server Configuration
PORT=3001
API_SECRET_KEY=rudra_super_secret_api_key_change_me_in_production

# Sender Identity
DEFAULT_FROM_NAME="Rudresh Patel"
DEFAULT_FROM_EMAIL="updates@rudreshp.me"

# ================================================================
# OPTION 1: Brevo Free SMTP (Best for custom domain rudreshp.me)
# 300 emails/day = 9,000 emails/month (100% Free)
# ================================================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_account_login@email.com
SMTP_PASS=your_brevo_smtp_master_key

